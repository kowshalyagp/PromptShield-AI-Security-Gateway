# ==========================================
# PromptShield AI Gateway Environment Variables
# Rename this file to .env and configure values
# ==========================================

# Core Application Settings
PROJECT_NAME="PromptShield Gateway"
API_V1_STR=/api/v1

# Security / Authentication (Generate a secure random key in production)
SECRET_KEY=placeholder_super_secure_signing_secret_key_change_me
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Connectivity
# SQLite is default for local development. Use PostgreSQL in production if needed.
DATABASE_URL=sqlite+aiosqlite:///./promptshield.db

# External LLM / Gemini Integration
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# System Rate Limiting
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=10

# Threat & Safety Classification Thresholds (0-100 scale)
RISK_THRESHOLD_MALICIOUS=70
RISK_THRESHOLD_SUSPICIOUS=30

# Logging Configurations (DEBUG, INFO, WARNING, ERROR)
LOGGING_LEVEL=INFO
